# ======================================================
# СЕКРЕТИ — НІКОЛИ НЕ ДОДАВАТИ В GIT
# ======================================================

# Змінні оточення з API-ключами
.env
.env.*
.env.local
.env.production
.env.development

# Будь-які файли ключів
*.key
*.pem
*.p12
*.pfx
secrets.*

# ======================================================
# ЗАЛЕЖНОСТІ І ЗБІРКИ
# ======================================================
node_modules/
dist/
build/
.venv/

# Python кеш pip
pip-build-tracker-*/
pip-ephem-wheel-cache-*/
pip-install-*/

# ======================================================
# IDE / СИСТЕМНЕ
# ======================================================
.idea/
.vscode/settings.json
*.log
.DS_Store
Thumbs.db

# ChatGPT/Codex transfer artifacts
/chatgpt_upload_ready.zip
/chatgpt_upload_ready/
/project_snapshot/
/project_snapshot_*/
/REDMY10.code-workspace

# ======================================================
# OS / EDITOR NOISE
# ======================================================
desktop.ini
*.swp
*.swo
*.bak

# ======================================================
# LOGS / CACHE / TEMP
# ======================================================
*.tmp
*.temp
*.cache
.tmp/
tmp/
temp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ======================================================
# TEST / BUILD ARTIFACTS
# ======================================================
coverage/
test-results/
playwright-report/

# ======================================================
# LOCAL SECRETS / CONFIG
# ======================================================
*.local

# ======================================================
# KNOWN PERUKAR AGENT / GIT ANOMALY ARTIFACTS
# ======================================================
# Cloud-sync transient upload staging folder (Google Drive FUSE)
.tmp.driveupload/

# Stale git index lock artifacts — sandbox/FUSE phantom locks
# .git/index.lock itself lives inside .git and is never tracked.
# These patterns cover stale lock copies that may appear in the worktree.
index.lock.stale*
.lock.stale

# AI agent scratch directories — must not be committed
.cline/
.cursor/
.roo/
.continue/
.aider*
.codex/
